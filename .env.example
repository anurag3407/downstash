# Downstash — example environment (copy to .env and fill in). Never commit real secrets.
# Downstash does NOT generate these; the operator must obtain them.

# --- Supabase (single project, one per deployment) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Connection string used by migrations & tests (service role).
SUPABASE_DB_URL=postgresql://postgres.****:****@aws-0-****.pooler.supabase.com:5432/postgres

# --- Upstash fallback (optional; enables failover) ---
UPSTASH_REDIS_REST_URL=https://****.upstash.io
UPSTASH_REDIS_REST_TOKEN=****

# --- Gateway ---
TOKEN_ENCRYPTION_KEY=   # 32-byte key, hex (64 chars). Generate: pnpm gen:enc-key
UPSTASH_TIMEOUT_MS=200

# --- Web (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_****
CLERK_SECRET_KEY=sk_test_****
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3000
CONSOLE_DEFAULT_TOKEN_NAME=default
